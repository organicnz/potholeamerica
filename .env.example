# ==============================================================================
# Pothole America — Environment Variables Template
# Copy this file to .env.local and fill in your values
# ==============================================================================

# 1. Supabase Public & Client Config
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
NEXT_PUBLIC_SUPABASE_LEGACY_ANON_KEY=your-legacy-jwt-anon-key

# Application Site Base URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 2. Supabase Server-Side & Secret Keys (Privileged Server Only)
SUPABASE_SERVICE_ROLE_KEY=your-secret-key
SUPABASE_SECRET_KEY=your-secret-key
SUPABASE_LEGACY_SERVICE_ROLE_KEY=your-legacy-jwt-service-role-key

# Supabase Management API
SUPABASE_ACCESS_TOKEN=your-personal-access-token
SUPABASE_PROJECT_ID=your-project-ref

# 3. Supabase JWT Signing Keys
SUPABASE_JWT_KEY_ID=your-jwt-key-id
SUPABASE_JWT_KEY_TYPE=ECC_P256
SUPABASE_PREVIOUS_JWT_KEY_ID=your-previous-jwt-key-id

# 4. Postgres & Supabase Connection Pooler
SUPABASE_DB_HOST=your-pooler-host
SUPABASE_DB_PORT=6543
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres.your-project-ref
# DATABASE_URL="postgresql://postgres.your-project-ref:[YOUR-PASSWORD]@your-pooler-host:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://postgres.your-project-ref:[YOUR-PASSWORD]@your-pooler-host:5432/postgres"
